# Development Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database (SQLite untuk development, PostgreSQL untuk production)
DATABASE_URL=sqlite:///datadesa.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# File uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=52428800  # 50MB

# Admin defaults (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@desa-way-ilahan.local

# Email (optional, untuk notifikasi)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend URL (untuk link di email)
FRONTEND_URL=https://rizkisyamsulh354-svg.github.io/datadesa1

# CORS
CORS_ORIGINS=*
